# Server authentication (leave empty to skip auth)
PHONOS_AUTH_TOKEN=

# Whisper model
PHONOS_MODEL=base.en
PHONOS_MODELS=tiny.en,base.en,small.en,medium.en,large-v3,turbo,distil-large-v3

# Whisper device settings
PHONOS_DEVICE=cpu
PHONOS_COMPUTE_TYPE=int8

# Voice activity detection filter
PHONOS_VAD_FILTER=true

# Maximum transcription processing time per request
PHONOS_TRANSCRIBE_TIMEOUT_SECONDS=600

# Maximum uploaded audio file size
PHONOS_MAX_UPLOAD_MB=100
